# Copy this file to .env.staging and replace every placeholder.
# Only browser-public staging coordinates are accepted. Never add service-role,
# secret, database, provider, JWT/anon, password, or access-token values.
STAGING_SUPABASE_PROJECT_REF=replace_with_20_char_staging_ref
STAGING_SUPABASE_URL=https://replace_with_20_char_staging_ref.supabase.co
STAGING_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_staging_browser_key

# These safety gates are hard-coded by scripts/staging_workbench.py and cannot
# be overridden from this file:
# REAL_GENERATION_ENABLED=false
# ALLOW_REAL_SPEND=false
# CHARACTER_PERFORMANCE_ENABLED=false
